# ---------------------------------------------------------------------------
# 이 저장소는 코드만 공개한다. MIMIC-IV는 PhysioNet 데이터 사용 동의에 따라
# 원자료도, 그로부터 파생된 record 단위 데이터도 재배포할 수 없다.
# 아래 항목이 실수로 커밋되는 것을 막는다.
# ---------------------------------------------------------------------------

# MIMIC 원자료와 파생 캐시 — 재배포 금지
mimic_data/
cache/
*.csv.gz
*.parquet

# 실행 산출물 — artifacts/ 에는 입원 건별 실제/예측 재원일수 배열이 들어간다.
# 식별자는 없으나 record 단위이므로 공개하지 않는다.
artifacts/
*.npy

# 백업 아카이브 — 위 항목을 포함하므로 저장소에 올리지 않는다
*.tar.gz
*.zip

# 실행 시 생성되는 표와 그림. 논문 수치는 원고와 노트북 출력에 이미 있다.
# 집계표를 공개하기로 정하면 이 두 줄을 지우고 tables/ 만 커밋한다
# (figures/ 가 아니라 tables/ 만 — 그림은 노트북 출력으로 볼 수 있다).
tables/
figures/

# 파이썬
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db
